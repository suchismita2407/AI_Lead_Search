# Required: pooled Postgres connection string from Neon or Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required in production: a high-entropy value (at least 32 characters).
SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=https://app.example.com

# Required to deliver verification and password-reset emails via Resend.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=DealFlow AI <noreply@example.com>

# Optional: choose "groq" for a low-cost OpenAI-compatible provider or "openai".
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# Dodo Payments merchant-of-record billing. Products must be monthly USD
# subscription products created in the Dodo dashboard. Keep these server-only.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_STARTER_USD=
DODO_PRODUCT_PRO_USD=
DODO_PRODUCT_INVESTOR_PLUS_USD=
